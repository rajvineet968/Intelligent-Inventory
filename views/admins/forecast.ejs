<%- layout("layouts/boilerplate") %>

<div class="container mt-5">
    <h2 class="text-center text-light mb-4">
        Demand Forecast – Next 30 Days
    </h2>

    <div class="card chart-card p-4 shadow">
        <canvas id="forecastChart"></canvas>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

<script>
    const labels = <%- JSON.stringify(forecasts.map(f => f.Description)) %>;
    const data = <%- JSON.stringify(forecasts.map(f => f.avgDemand)) %>;

    // 🔥 COMPRESSED AI INSIGHTS (3-line safe format)
    const aiInsights = data.map(d => {
        if (d >= 8) {
            return ["High demand", "Stock up"];
        } else if (d >= 5) {
            return ["Stable demand", "Maintain inventory"];
        } else {
            return ["Low demand", "Avoid overstock"];
        }
    });

    new Chart(document.getElementById('forecastChart'), {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                data,
                backgroundColor: 'rgba(13,110,253,0.85)',
                borderRadius: 14,
                barThickness: 38
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },

                // ✅ SAFE MULTI-LINE LABELS
                datalabels: {
                    anchor: 'end',
                    align: 'top',
                    offset: 8,
                    clamp: true,
                    formatter: (value, ctx) => {
                        const insight = aiInsights[ctx.dataIndex];
                        return `Avg: ${value} units/day\n${insight[0]}\n${insight[1]}`;
                    },
                    textAlign: 'center',
                    font: {
                        size: 11,
                        weight: '600',
                        lineHeight: 1.3
                    },
                    color: '#111827',
                    backgroundColor: 'rgba(255,255,255,0.95)',
                    borderRadius: 8,
                    padding: {
                        top: 6,
                        bottom: 6,
                        left: 8,
                        right: 8
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grace: '45%',   // 🔥 prevents any cut-off
                    title: {
                        display: true,
                        text: 'Units / Day'
                    }
                },
                x: {
                    ticks: {
                        maxRotation: 20,
                        minRotation: 15
                    }
                }
            }
        },
        plugins: [ChartDataLabels]
    });
</script>
